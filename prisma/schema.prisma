generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id      Int     @id @default(autoincrement())
  nome    String
  email   String  @unique
  senha   String
  role    String
}

// Os locais (salas, laboratórios, tendas…) são fixos e vêm do catálogo
// em src/data/locais.json; o projeto guarda só o id do local.
model Project {
  id          Int       @id @default(autoincrement())
  number      Int       @unique
  title       String
  localId     String
  complemento String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([localId])
}
